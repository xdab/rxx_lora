From d0d2841536f08c8861a3fba725d33a3eef4f4c46 Mon Sep 17 00:00:00 2001
From: xdab <47300315+xdab@users.noreply.github.com>
Date: Sun, 1 Nov 2026 19:26:52 +0100
Subject: [PATCH] sfd: compute each slot decimation and pair spectrum once

The coarse change-point loop re-computed each interior pair slot's
spectrum twice (as q of one hypothesis and q+1 of the next); the 8
SFD_Q_MIN..Q_MAX+1 spectra are now computed once into a cache and the
q-loop only re-indexes. The fine pass re-decimated 4 offsets shared by
the down/up references; decimation is ref-independent, so the 12 unique
slots are decimated once and both ref FFTs read the shared rows.
sfd_slot_mag splits into decimate + sfd_slot_ref_fft accordingly;
dmag0/dmag1 fold into the dpair cache.

regression.py 41/41.
---
 src/frame_sync_internal.h | 22 ++++++++-----
 src/sfd.c                 | 65 ++++++++++++++++++++++++---------------
 2 files changed, 54 insertions(+), 33 deletions(-)

diff --git a/src/frame_sync_internal.h b/src/frame_sync_internal.h
index 2ee0ab7..7e7d276 100644
--- a/src/frame_sync_internal.h
+++ b/src/frame_sync_internal.h
@@ -38,6 +38,12 @@ enum frame_sync_subphase
 #define SFD_FINE_DN 10
 #define SFD_FINE_UP 6
 
+/** Fine-pass decimated slots, offsets -8..3 windows (shared by both refs). */
+#define SFD_FINE_DEC 12
+
+/** Coarse change-point pair-slot spectra, slots SFD_Q_MIN..SFD_Q_MAX+1 (4N each). */
+#define SFD_DPAIR 8
+
 /** Pairing representatives: (tau, f) and (tau +- N/2, f +- N/2) at most. */
 #define SFD_MAX_TAU_REPS 3
 
@@ -60,14 +66,14 @@ struct sfd
     dsp_cpx *cx_in;          // FFT input scratch shared by both plans
     dsp_cpx *cx_out;         // FFT output scratch shared by both plans
     float complex *slot;     // one decimated slot (N)
-    float *lockmag;          // lock magnitude spectrum (lock_len)
-    float *mag;              // one slot magnitude spectrum (4N)
-    float *dmag0;            // change-point D spectra (4N each)
-    float *dmag1;
-    float *dsum;    // sqrt-power-sum scratch over the D pair (4N)
-    float *med;     // median scratch (4N)
-    float *fine_dn; // fine-pass down-ref spectra (SFD_FINE_DN x 4N)
-    float *fine_up; // fine-pass up-ref spectra (SFD_FINE_UP x 4N)
+    float *lockmag;          // lock power spectrum (lock_len)
+    float *mag;              // one slot power spectrum (4N)
+    float *dpair;            // change-point pair-slot power spectra (SFD_DPAIR x 4N)
+    float *dsum;             // power-sum scratch over the D pair (4N)
+    float *med;              // median scratch (4N)
+    float complex *fine_dec; // fine-pass decimated slots (SFD_FINE_DEC x N)
+    float *fine_dn;          // fine-pass down-ref power spectra (SFD_FINE_DN x 4N)
+    float *fine_up;          // fine-pass up-ref power spectra (SFD_FINE_UP x 4N)
 };
 
 /** SFD-first coarse-sync outcome (src/sfd.c): the frame-grid decision at the
diff --git a/src/sfd.c b/src/sfd.c
index 19a1948..d7a0456 100644
--- a/src/sfd.c
+++ b/src/sfd.c
@@ -108,21 +108,17 @@ sfd_slot_dec(const struct frame_sync *s, const float complex *in, int64_t off, f
     }
 }
 
-/* Magnitude spectrum (4N bins, zero-padded) of the slot at `off`, dechirped
- * by ref (downchirp for upchirp slots, upchirp for the SFD's downchirps). */
-static void sfd_slot_mag(
-    struct frame_sync *s,
-    const float complex *in,
-    int64_t off,
-    const float complex *ref,
-    float *mag)
+/* Power spectrum (4N bins, zero-padded) of an already-decimated slot,
+ * dechirped by ref (downchirp for upchirp slots, upchirp for the SFD's
+ * downchirps). */
+static void sfd_slot_ref_fft(
+    struct frame_sync *s, const float complex *dec, const float complex *ref, float *mag)
 {
     const uint32_t n = s->number_of_bins, n4 = 4u * n;
 
-    sfd_slot_dec(s, in, off, s->sfd.slot);
     for (uint32_t j = 0; j < n; j++)
     {
-        float complex v = s->sfd.slot[j] * ref[j];
+        float complex v = dec[j] * ref[j];
         s->sfd.cx_in[j].r = crealf(v);
         s->sfd.cx_in[j].i = cimagf(v);
     }
@@ -132,6 +128,18 @@ static void sfd_slot_mag(
         mag[i] = s->sfd.cx_out[i].r * s->sfd.cx_out[i].r + s->sfd.cx_out[i].i * s->sfd.cx_out[i].i;
 }
 
+/* Power spectrum of the slot at `off`: decimate, then sfd_slot_ref_fft(). */
+static void sfd_slot_mag(
+    struct frame_sync *s,
+    const float complex *in,
+    int64_t off,
+    const float complex *ref,
+    float *mag)
+{
+    sfd_slot_dec(s, in, off, s->sfd.slot);
+    sfd_slot_ref_fft(s, s->sfd.slot, ref, mag);
+}
+
 /* Coherent lock over `count` consecutive slots from `off`: dechirp each,
  * concatenate (the tone is phase-continuous across symbols), zero-pad,
  * fractional peak. Returns u = f + tau, in symbol bins. */
@@ -183,17 +191,17 @@ int sfd_alloc(struct frame_sync *s)
     f->slot = malloc(n * sizeof(*f->slot));
     f->lockmag = malloc(f->lock_len * sizeof(*f->lockmag));
     f->mag = malloc(4 * (size_t)n * sizeof(*f->mag));
-    f->dmag0 = malloc(4 * (size_t)n * sizeof(*f->dmag0));
-    f->dmag1 = malloc(4 * (size_t)n * sizeof(*f->dmag1));
+    f->dpair = malloc((size_t)SFD_DPAIR * 4 * n * sizeof(*f->dpair));
     f->dsum = malloc(4 * (size_t)n * sizeof(*f->dsum));
     f->med = malloc(4 * (size_t)n * sizeof(*f->med));
+    f->fine_dec = malloc((size_t)SFD_FINE_DEC * n * sizeof(*f->fine_dec));
     f->fine_dn = malloc((size_t)SFD_FINE_DN * 4 * n * sizeof(*f->fine_dn));
     f->fine_up = malloc((size_t)SFD_FINE_UP * 4 * n * sizeof(*f->fine_up));
     f->cx_in = malloc(f->lock_len * sizeof(*f->cx_in));
     f->cx_out = malloc(f->lock_len * sizeof(*f->cx_out));
     f->slot_fft_cfg = dsp_fft_alloc(4 * (int)n);
     f->lock_fft_cfg = dsp_fft_alloc((int)f->lock_len);
-    if (!f->slot || !f->lockmag || !f->mag || !f->dmag0 || !f->dmag1 || !f->dsum || !f->med ||
+    if (!f->slot || !f->lockmag || !f->mag || !f->dpair || !f->dsum || !f->med || !f->fine_dec ||
         !f->fine_dn || !f->fine_up || !f->cx_in || !f->cx_out || !f->slot_fft_cfg ||
         !f->lock_fft_cfg)
     {
@@ -226,10 +234,10 @@ void sfd_free(struct frame_sync *s)
     free(f->slot);
     free(f->lockmag);
     free(f->mag);
-    free(f->dmag0);
-    free(f->dmag1);
+    free(f->dpair);
     free(f->dsum);
     free(f->med);
+    free(f->fine_dec);
     free(f->fine_dn);
     free(f->fine_up);
     free(f->cx_in);
@@ -358,15 +366,21 @@ static int sfd_coarse(
         upow[o + 4] = sfd_bin_pow(s->sfd.mag, n, *u_hat);
     }
 
+    /* Pair-slot spectra computed once: each interior slot feeds two q
+     * hypotheses (as q of one and q+1 of the previous). */
+    for (int sl = 0; sl < SFD_DPAIR; sl++)
+        sfd_slot_mag(
+            s, in, (int64_t)(SFD_Q_MIN + sl) * sps, s->upchirp, s->sfd.dpair + (size_t)sl * n4);
+
     float best_score = -HUGE_VALF;
     *q_hat = SFD_Q_MIN;
     *d_hat = 0.0f;
     for (int q = SFD_Q_MIN; q <= SFD_Q_MAX; q++)
     {
-        sfd_slot_mag(s, in, (int64_t)q * sps, s->upchirp, s->sfd.dmag0);
-        sfd_slot_mag(s, in, (int64_t)(q + 1) * sps, s->upchirp, s->sfd.dmag1);
+        const float *m0 = s->sfd.dpair + (size_t)(q - SFD_Q_MIN) * n4;
+        const float *m1 = m0 + n4;
         for (uint32_t i = 0; i < n4; i++)
-            s->sfd.dsum[i] = s->sfd.dmag0[i] + s->sfd.dmag1[i];
+            s->sfd.dsum[i] = m0[i] + m1[i];
 
         float dpk;
         float kd = dsp_frac_peak(s->sfd.dsum, n4, &dpk);
@@ -416,19 +430,20 @@ static int sfd_fine(
         int64_t t_cand = (int64_t)q_hat * sps - (int64_t)lroundf(taus[it] * (float)os);
         float u_r = sfd_lock(s, in, t_cand - 8 * sps, 6, u_hat);
 
-        // slot spectra once per representative; the shift scan re-indexes
+        // decimate each unique slot once (offsets -8..3); the down/up ref
+        // FFTs share the decimation
+        for (int j = -8; j <= 3; j++)
+            sfd_slot_dec(s, in, t_cand + (int64_t)j * sps, s->sfd.fine_dec + (size_t)(j + 8) * n);
         for (int j = -8; j <= 1; j++)
-            sfd_slot_mag(
+            sfd_slot_ref_fft(
                 s,
-                in,
-                t_cand + (int64_t)j * sps,
+                s->sfd.fine_dec + (size_t)(j + 8) * n,
                 s->downchirp,
                 s->sfd.fine_dn + (size_t)(j + 8) * n4);
         for (int j = -2; j <= 3; j++)
-            sfd_slot_mag(
+            sfd_slot_ref_fft(
                 s,
-                in,
-                t_cand + (int64_t)j * sps,
+                s->sfd.fine_dec + (size_t)(j + 8) * n,
                 s->upchirp,
                 s->sfd.fine_up + (size_t)(j + 2) * n4);
 
-- 
